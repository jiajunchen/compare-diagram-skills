rectangle "Open confirmed bout" as bout <<theme_dim>>
rectangle "Import Recordings\nPhotosPicker: up to 20 videos" as pick <<theme_blue>>
rectangle "BoutImportCoordinator.prepareSelections\nPhotoLibraryService reads metadata / Photos IDs\nshow batch, failures, cancellation" as prepare <<theme_green>>
rectangle "Confirm batch\ninsert SourceRecording links in SwiftData\ntry linking iCloud Photos IDs" as confirm <<theme_green>>
rectangle "Review and Trim Recordings\nload ordered sources + clips" as timeline <<theme_blue>>
rectangle "Open source\nPhotoKit AVAsset; local fallback if needed" as asset <<theme_green>>
rectangle "Select trim range\nClipWorkflow.createClip -> AVFoundation export\nReviewClip: exporting -> pendingUpload" as trim <<theme_green>>
rectangle "ClipUploadQueue.upload\nsync metadata -> save CKAsset\nReviewClip: uploading -> available" as upload <<theme_cyan>>
rectangle "Failure path\nexportFailed / pendingUpload / needsAttention\nretry export or upload" as fail <<theme_red>>
rectangle "Play clip / Play Bout\nordered ReviewClips -> playableURL" as play <<theme_blue>>
rectangle "Local export or managed cache?" as local <<theme_orange>>
rectangle "ClipDownloadCoordinator.resolve\ncheck iCloud -> download CKAsset -> cache" as download <<theme_green>>
rectangle "MediaPlayerModel + BoutPlaybackQueue\nseek, scrub, speed, next clip (continuous)" as player <<theme_green>>
rectangle "Unload / Clear Local Copies\nonly confirmed available exports; clear cache\nretain CloudKit records/assets" as offload <<theme_orange>>
rectangle "Delete clip/source/bout/tournament\nasset first, then local records, queue metadata deletion\nPhotos original stays intact" as delete <<theme_red>>
bout --> pick
pick --> prepare
prepare --> confirm : Add to Bout
confirm --> timeline
timeline --> asset
asset --> trim
trim --> upload : export success
trim --> fail : export failure
upload --> fail : cloud failure
upload --> play : available
fail ..> upload : retry
play --> local
local --> player : yes
local --> download : no
download --> player
player --> offload : optional
timeline ..> delete : optional
@enduml
