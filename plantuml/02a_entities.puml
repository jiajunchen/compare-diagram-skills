class "AppSettings\nPK id (stable cloudID)\nfencerName, syncState" as settings <<theme_cyan>>
class "Tournament\nPK id\nname, venue, startDate, timezone\nscheduleImportStatus, syncState" as tournament <<theme_blue>>
class "Bout\nPK id | FK tournamentID\nphase, opponent, sequenceNumber\npool, strip, scheduledAt, syncState" as bout <<theme_blue>>
class "SourceRecording\nPK id | FK tournamentID, boutID\nimportBatchID, Photos IDs\nrecordedAt, duration, localWorkingFilePath" as source <<theme_green>>
class "ReviewClip\nPK id | FK boutID, sourceRecordingID\ntrim range, localExportPath\ncloudAssetRecordName, mediaSyncStatus\nisFavorite" as clip <<theme_green>>
class "ScheduleExtractionRun\nPK id | FK tournamentID\nstatus, warnings, modelAssistanceUsed\n(schema only; no production inserts)" as run <<theme_orange>>
class "PHAsset (Photos)\noriginal recording" as photo <<theme_dim>>
class "CKRecord + CKAsset\nReviewClip-{UUID}" as asset <<theme_dim>>
settings ..> tournament : one fencer name used by all tournaments
tournament --> bout : 1 -> 0..*
tournament ..> source : 1 -> 0..* direct ID
bout --> source : 1 -> 0..*
bout ..> clip : 1 -> 0..* direct ID
source --> clip : 1 -> 0..*
tournament ..> run : 1 -> 0..* schema
source ..> photo : deviceLocalAssetID / cloudPhotoAssetID
clip ..> asset : cloudAssetRecordName
