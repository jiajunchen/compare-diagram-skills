      "text": "# 02A  Persisted entities — UUID references, not SwiftData @Relationship",
      "x": 44,
      "y": 45,
      "width": 1832,
      "height": 65,
      "color": "#00d4ff"
    },
    {
      "id": "1cf321d3d0e81612",
      "type": "text",
      "text": "**AppSettings**\nPK id (stable cloudID)\nfencerName, syncState",
      "x": 894,
      "y": 139,
      "width": 140,
      "height": 78,
      "color": "#00d4ff"
    },
    {
      "id": "075f95cc4337f085",
      "type": "text",
      "text": "**Tournament**\nPK id\nname, venue, startDate, timezone\nscheduleImportStatus, syncState",
      "x": 873,
      "y": 259,
      "width": 183,
      "height": 78,
      "color": "#2d7aff"
    },
    {
      "id": "1d44b1b17d83a549",
      "type": "text",
      "text": "**Bout**\nPK id | FK tournamentID\nphase, opponent, sequenceNumber\npool, strip, scheduledAt, syncState",
      "x": 723,
      "y": 375,
      "width": 192,
      "height": 78,
      "color": "#2d7aff"
    },
    {
      "id": "d37515cd2221a9bc",
      "type": "text",
      "text": "**SourceRecording**\nPK id | FK tournamentID, boutID\nimportBatchID, Photos IDs\nrecordedAt, duration, localWorkingFilePath",
      "x": 853,
      "y": 491,
      "width": 223,
      "height": 78,
      "color": "#00e5a0"
    },
    {
      "id": "321f69350453c432",
      "type": "text",
      "text": "**ReviewClip**\nPK id | FK boutID, sourceRecordingID\ntrim range, localExportPath\ncloudAssetRecordName, mediaSyncStatus\nisFavorite",
      "x": 664,
      "y": 619,
      "width": 224,
      "height": 83,
      "color": "#00e5a0"
    },
    {
      "id": "cb811e1750e1ef41",
      "type": "text",
      "text": "**ScheduleExtractionRun**\nPK id | FK tournamentID\nstatus, warnings, modelAssistanceUsed\n(schema only; no production inserts)",
      "x": 1046,
      "y": 375,
      "width": 209,
      "height": 78,
      "color": "#ff8c42"
    },
    {
      "id": "09657ad5e5ba81d1",
      "type": "text",
      "text": "**PHAsset (Photos)**\noriginal recording",
      "x": 894,
      "y": 622,
      "width": 140,
      "height": 78,
      "color": "#4a6080"
    },
    {
      "id": "25b94c6f0d452bc3",
      "type": "text",
      "text": "**CKRecord + CKAsset**\nReviewClip-{UUID}",
      "x": 706,
      "y": 733,
      "width": 140,
      "height": 78,
      "color": "#4a6080"
    },
    {
      "id": "3c7c168ccc85db5d",
      "type": "text",
      "text": "**How to read**  Arrows represent UUID references or links to external assets, not runtime calls. ScheduleExtractionRun exists in the schema without a production insert path.",
