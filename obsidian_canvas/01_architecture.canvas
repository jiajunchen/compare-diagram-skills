    {
      "id": "15a7b6c8c66dd6dd",
      "type": "text",
      "text": "# 01  Overall codebase architecture — one native iPhone / iPad app",
      "x": 44,
      "y": 45,
      "width": 1832,
      "height": 65,
      "color": "#00d4ff"
    },
    {
      "id": "de076a5d80a180ae",
      "type": "text",
      "text": "**Parent / fencer**\nSwiftUI actions",
      "x": 958,
      "y": 137,
      "width": 140,
      "height": 78,
      "color": "#4a6080"
    },
    {
      "id": "c32e09ccc83f0e80",
      "type": "text",
      "text": "**AppRootView**\nlaunch + scene activation",
      "x": 638,
      "y": 357,
      "width": 155,
      "height": 78,
      "color": "#2d7aff"
    },
    {
      "id": "b1293864f24fd90d",
      "type": "text",
      "text": "**Tournament, schedule, bout,**\ntimeline, player, settings views",
      "x": 939,
      "y": 256,
      "width": 178,
      "height": 78,
      "color": "#2d7aff"
    },
    {
      "id": "860be6a0c79335b0",
      "type": "text",
      "text": "**AppViewModel**\nUI state + workflow orchestration",
      "x": 774,
      "y": 458,
      "width": 192,
      "height": 78,
      "color": "#00d4ff"
    },
    {
      "id": "b5e26a2737837905",
      "type": "text",
      "text": "**ScheduleReviewViewModel**\neditable, unconfirmed drafts",
      "x": 807,
      "y": 357,
      "width": 168,
      "height": 78,
      "color": "#00d4ff"
    },
    {
      "id": "9d84495f41292244",
      "type": "text",
      "text": "**Schedule source -> Vision recognition**\n-> deterministic parser -> Foundation Model\n-> proposal validator",
      "x": 1425,
      "y": 583,
      "width": 242,
      "height": 78,
      "color": "#00e5a0"
    },
    {
      "id": "8c6c7a2fe7467ba7",
      "type": "text",
      "text": "**BoutImportCoordinator**\nPhotoLibraryService",
      "x": 758,
      "y": 583,
      "width": 145,
      "height": 78,
      "color": "#00e5a0"
    },
    {
      "id": "25cf70d776718180",
      "type": "text",
      "text": "**ClipWorkflow -> VideoEditingService**\nAVFoundation export",
      "x": 534,
      "y": 583,
      "width": 210,
      "height": 78,
      "color": "#00e5a0"
    },
    {
      "id": "3d4c80ac68316614",
      "type": "text",
      "text": "**ClipUploadQueue**\nCloudMetadataService + CloudAssetService",
      "x": 918,
      "y": 583,
      "width": 246,
      "height": 78,
      "color": "#00e5a0"
    },
    {
      "id": "90ac210c9fe85845",
      "type": "text",
      "text": "**BoutPlaybackQueue + MediaPlayerModel**\nClipDownloadCoordinator + cache",
      "x": 1178,
      "y": 583,
      "width": 233,
      "height": 78,
      "color": "#00e5a0"
    },
    {
      "id": "13d0eac61fbc9b03",
      "type": "text",
      "text": "**LocalRepository / SwiftData**\nsettings, tournaments, bouts, source links, clips",
      "x": 464,
      "y": 708,
      "width": 256,
      "height": 78,
      "color": "#ff8c42"
    },
    {
      "id": "1a76ca4dc52db6c3",
      "type": "text",
      "text": "**App support files**\npending exports + downloaded clips",
      "x": 735,
      "y": 708,
      "width": 205,
      "height": 78,
      "color": "#ff8c42"
    },
    {
      "id": "2c1c3ffd45d353c3",
      "type": "text",
      "text": "**Screenshot bytes + OCR/proposal**\nin memory until confirmation",
      "x": 252,
      "y": 708,
      "width": 198,
      "height": 78,
      "color": "#ff8c42"
    },
    {
      "id": "d3ec4ed26b75781a",
      "type": "text",
      "text": "**Photos / iCloud Photos**\noriginal videos; read on explicit import/open",
      "x": 963,
      "y": 708,
      "width": 238,
      "height": 78,
      "color": "#4a6080"
    },
    {
      "id": "42095348d0d70f74",
      "type": "text",
      "text": "**Private CloudKit**\nconfirmed metadata + edited CKAssets",
      "x": 1216,
      "y": 708,
      "width": 221,
      "height": 78,
      "color": "#4a6080"
    },
    {
      "id": "b628aa2f0b435280",
      "type": "text",
      "text": "**How to read**  One native SwiftUI app. SwiftData is local; Photos retains originals; private CloudKit syncs confirmed metadata and edited clips. No app-owned backend server.",
      "x": 52,
      "y": 830,
      "width": 1816,
      "height": 60,
      "color": "#00d4ff"
    },
