rectangle "FencingVideoAnalysisApp\nAppDependencies.make -> AppRootView" as entry <<theme_dim>>
rectangle "SwiftUI views\nforms, schedule, bout, timeline, player, settings" as ui <<theme_blue>>
rectangle "AppViewModel\nload / refreshCloud\nsaveTournament / confirmSchedule / addBout*\nprepare/confirmRecordings / createClip\nplayableURL / delete / offload" as vm <<theme_cyan>>
rectangle "ScheduleReviewViewModel\nextract / addDraft / removeDraft / moveDraft" as review <<theme_blue>>
rectangle "Schedule services\nrecognize -> parse -> propose -> reconcile" as schedule <<theme_green>>
rectangle "BoutImportCoordinator\nprepareSelections / confirm / linkPendingCloudPhotos\nsourceAsset / move / remove" as bout <<theme_green>>
rectangle "ClipWorkflow\ncreateClip / retry / delete / clips\nunloadUploadedClips / clearLocalClipCopies" as clip <<theme_green>>
rectangle "ClipUploadQueue\nresumePending / upload / retry / deleteCloudCopyIfNeeded" as queue <<theme_green>>
rectangle "CloudMetadataService\nsynchronize / synchronizeDeletions / queueDeletion\nmapper pendingRecords / apply" as cloud <<theme_green>>
rectangle "CloudAssetService\nsaveExportedClip / downloadClip / deleteClip" as assets <<theme_green>>
rectangle "ClipDownloadCoordinator\nresolve / clearCache / removeCachedCopies" as download <<theme_green>>
rectangle "BoutPlaybackQueue + MediaPlayerModel\nnext / previous / finish / play / seek / scrub" as player <<theme_green>>
rectangle "LocalRepository\ninsert / fetch / delete / saveChanges\ntournaments / bouts / sourceRecordings / reviewClips" as repo <<theme_orange>>
rectangle "PhotoLibraryService\nimportSelections / cloudIdentifiers / videoAsset" as photos <<theme_dim>>
rectangle "VideoEditingService.export" as editor <<theme_dim>>
rectangle "Private CloudKit + Photos\nframework boundaries" as ck <<theme_dim>>
entry --> ui
ui --> vm : commands
ui --> review : schedule
ui --> player : playback controls
review --> schedule
review --> vm : confirmed drafts
vm --> bout
vm --> clip
vm --> queue
vm --> cloud
vm --> download
vm --> repo
bout --> photos
bout --> repo
clip --> editor
clip --> repo
queue --> cloud
queue --> assets
download --> assets
cloud --> repo
photos --> ck : Photos
assets --> ck : CKAsset
cloud --> ck : CKSyncEngine
@enduml
